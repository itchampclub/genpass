# Port the genpass server dev/prod server listens on.
PORT=8788

# --- Apple Wallet Pass Type ID certificate chain ---
# All three certs must be base64-encoded PEM content (single line).
# See ../README.md for how to export these from your Apple Developer
# "Pass Type ID" certificate (.p12) using openssl.
APPLE_WWDR_CERT_BASE64=
APPLE_SIGNER_CERT_BASE64=
APPLE_SIGNER_KEY_BASE64=
# Only needed if the signer key was exported with a passphrase.
APPLE_SIGNER_KEY_PASSPHRASE=

# From developer.apple.com > Certificates, Identifiers & Profiles.
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_TYPE_IDENTIFIER=pass.com.example.genpass
